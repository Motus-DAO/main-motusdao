# Motty env (LandingMotus)

# Same Venice model + API as ~/.hermes/config.yaml (public Motty, not RootRouter proxy).
# MOTTY_AI_API_KEY overrides VENICE_API_KEY if both are set.
MOTTY_AI_BASE_URL=https://api.venice.ai/api/v1
MOTTY_AI_MODEL=deepseek-v4-flash-0731
VENICE_API_KEY=

# Signed visitor session cookie. Required in production.
MOTTY_SESSION_SECRET=

# Motus Knowledge MCP (public searchKnowledge only)
MOTTY_MCP_URL=https://mcp.motusdao.org/mcp

# Handoff adapter — do not hardcode a channel in code.
# kind: disabled | url | email
MOTTY_HANDOFF_KIND=disabled
MOTTY_HANDOFF_URL=
MOTTY_HANDOFF_LABEL=

